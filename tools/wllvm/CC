#!/bin/bash

export PATH=/usr/local/cuda-11.1/bin:/apollo/scripts:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LD_LIBRARY_PATH=/usr/lib64:$LD_LIBRARY_PATH
export LLVM_COMPILER=clang
export WLLVM_BC_STORE=/apollo_workspace/wllvm_bc
export LLVM_BITCODE_GENERATION_FLAGS="-flto -fwhole-program-vtables"
export THE_USER=$(whoami)

# wllvm's bitcode side-generation re-invokes clang with -emit-llvm on the same
# argv. Clang rejects that combination when compiling a single -o for multiple
# CUDA architectures ("cannot specify -o when generating multiple output
# files"), which turns the whole action into a hard failure. Bypass wllvm for
# multi-arch CUDA fatbin compiles and just compile normally (no bitcode for
# these device-code files).
arch_count=0
for arg in "$@"; do
  case "$arg" in
    --cuda-gpu-arch=*) arch_count=$((arch_count + 1)) ;;
  esac
done

if [ "$arch_count" -ge 2 ]; then
  exec clang "$@"
fi

exec /home/$THE_USER/.local/bin/wllvm "$@"